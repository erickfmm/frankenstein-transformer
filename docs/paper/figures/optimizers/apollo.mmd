flowchart TD
  G["Gₜ = ∇φ(Wₜ)"]
  cond{"t mod T = 0?"}
  samp["resample Pₜ ~ N(0, 1/r)"]
  R["Rₜ = PₜGₜ"]
  MR["Mᴿ ← β₁Mᴿ + (1−β₁)Rₜ"]
  VR["Vᴿ ← β₂Vᴿ + (1−β₂)Rₜ²"]
  Rn["R̃ = Mᴿ/(√Vᴿ + ε)"]
  var{"variant?"}
  srow["S = diag(‖R̃[i,:]‖/‖R[i,:]‖)<br/>APOLLO: channel-wise"]
  ssc["S = ‖R̃‖/‖R‖<br/>APOLLO-Mini: tensor-wise"]
  upd["Wₜ ← (1−ηλ)W − ηα(Gₜ ⊙ S)"]
  q["Q-APOLLO: moments stored quantized<br/>(per-tensor scale and offset)"]

  G --> cond
  cond -- "yes" --> samp --> R
  cond -- "no" --> R
  R --> MR
  R --> VR
  MR --> Rn
  VR --> Rn
  Rn --> var
  var -- "APOLLO" --> srow --> upd
  var -- "Mini" --> ssc --> upd
  MR -. "quantize / dequantize" .-> q
  VR -. "quantize / dequantize" .-> q
  q -.-> upd
